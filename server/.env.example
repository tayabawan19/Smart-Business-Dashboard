# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/smart_business_dashboard

# Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Python Analysis Microservice (Phase 4)
ANALYSIS_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=your_shared_internal_api_key_here

# Firebase Admin SDK Configuration (for token verification in later phases)
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=your_service_account_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
